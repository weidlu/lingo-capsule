{
  "name": "lingo-capsule",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && ./scripts/sign-macos-app.sh",
    "tauri:install": "pnpm tauri:build && ditto src-tauri/target/release/bundle/macos/LingoCapsule.app /Applications/LingoCapsule.app && ./scripts/sign-macos-app.sh /Applications/LingoCapsule.app && open -a /Applications/LingoCapsule.app",
    "provider:configure": "./scripts/configure-provider-settings.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}

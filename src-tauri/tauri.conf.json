{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingoCapsule",
  "version": "0.1.0",
  "identifier": "com.lingocapsule.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LingoCapsule",
        "width": 292,
        "height": 76,
        "minWidth": 220,
        "minHeight": 58,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": true,
        "focusable": true,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Quiet English feedback companion",
    "longDescription": "LingoCapsule is a floating desktop companion that turns real English writing into deliberate practice without interrupting the primary workflow.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
